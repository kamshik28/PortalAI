# ============================================================================
# portal-ai — vzor konfigurácie (.env.example)
# Skopíruj tento súbor na `.env` a doplň reálne hodnoty.
# NEVKLADAJ reálne hodnoty do tohto vzoru.
# ============================================================================

# --- Backend (core-api) -----------------------------------------------------
# Adresa backendu, na ktorý frontend preposiela požiadavky cez proxy trasy.
CORE_API_URL="http://localhost:4000"

# --- Flowise (externý konverzačný asistent) ---------------------------------
# Interná adresa Flowise pre proxy /api/v1/chat.
FLOWISE_INTERNAL_URL="http://localhost:2000"
# Základná adresa Flowise pre ostatné proxy volania.
FLOWISE_BASE="http://localhost:2000"
# ID naimportovaného Agentflow / chatflow-u vo Flowise.
FLOWISE_CHATFLOW_ID="<flowise-chatflow-id>"

# --- Prostredie -------------------------------------------------------------
NODE_ENV="development"

# ============================================================================
# Poznámka: Frontend NEpotrebuje DATABASE_URL ani OPENAI_API_KEY.
# Všetky volania databázy a OpenAI prebiehajú výhradne v core-api;
# frontend k nim pristupuje len cez core-api (CORE_API_URL).
# ============================================================================
