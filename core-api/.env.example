# ============================================================================
# core-api — vzor konfigurácie (.env.example)
# Skopíruj tento súbor na `.env` a doplň reálne hodnoty.
# NEVKLADAJ reálne kľúče do tohto vzoru ani ho necommituj s reálnymi hodnotami.
# ============================================================================

# --- PostgreSQL (Prisma) ----------------------------------------------------
# Pripojovací reťazec na databázu.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Supabase Storage (PDF materiály) ---------------------------------------
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
SUPABASE_STORAGE_BUCKET="<nazov-bucketu>"

# --- Qdrant (vektorová databáza) --------------------------------------------
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="<qdrant-api-key>"
QDRANT_COLLECTION="<nazov-kolekcie>"

# --- OpenAI -----------------------------------------------------------------
# Používa sa pre embeddingy (text-embedding-3-small) aj pre gpt-4o-mini.
OPENAI_API_KEY="sk-<your-openai-api-key>"

# --- Šifrovanie AIS relácie (AES-256-GCM) -----------------------------------
# Presne 64 hexadecimálnych znakov (= 32 bajtov).
# Vygeneruj príkazom:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ak nie je nastavený, UISAuth cookie sa uloží ako plaintext (len pre vývoj).
AIS_COOKIE_ENCRYPTION_KEY="<64-hex-znakov>"

# --- CORS / adresa frontendu ------------------------------------------------
# Adresa, z ktorej smie volať frontend (predvolene http://localhost:3000).
FRONTEND_URL="http://localhost:3000"

# --- Prostredie -------------------------------------------------------------
NODE_ENV="development"

# ============================================================================
# Voliteľné / pokročilé (majú bezpečné predvolené správanie, netreba nastavovať)
# ----------------------------------------------------------------------------
# Predvolený ID semestrového priečinka v AIS (fallback pri synchronizácii).
# AIS_SEMESTER_FOLDER_ID="<ais-folder-id>"
#
# Ladiaci výpis stromu AIS ("true" zapne podrobné logovanie štruktúry).
# AIS_DEBUG_TREE="false"
# ============================================================================
#
# Poznámka: Server počúva na pevnom porte 4000 (definované v src/main.ts),
# premenná PORT sa nepoužíva.
